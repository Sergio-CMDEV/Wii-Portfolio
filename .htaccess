ErrorDocument 404 /res/404.html
ErrorDocument 403 /res/403.html

Redirect 403 /.htaccess /res/403.html

# El panel de admin es una herramienta local: se abre con
# "node admin/server.js", que sirve los ficheros por su cuenta sin pasar por
# Apache. En el sitio publicado no pinta nada, así que se bloquea entero.
# Sin esto, /admin/ se servía como ficheros estáticos: el panel se veía,
# aunque sin servidor detrás no pudiera hacer nada.
RedirectMatch 403 ^/admin(/|$)

# Las credenciales del panel nunca se suben (están en .gitignore), pero por
# si alguna vez acaban en el servidor por otra vía.
RedirectMatch 403 ^/.*/auth\.json$

RewriteCond %{HTTP_USER_AGENT} \
RewriteCond %{HTTP_USER_AGENT} ^[Ww]eb[Bb]andit [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^Acunetix [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^binlar [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^BlackWidow [NC,OR]

RewriteEngine On
RewriteCond %{HTTP_REFERER} ^http://(.*)spamreferrer1\.org [NC,OR]
RewriteCond %{HTTP_REFERER} ^http://(.*)bandwidthleech\.com [NC,OR]
RewriteCond %{HTTP_REFERER} ^http://(.*)contentthieves\.ru [NC]
RewriteRule (.*) - [F,L]